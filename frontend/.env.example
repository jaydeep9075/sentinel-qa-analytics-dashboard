# Copy to .env.local for local dev.
#
# For Docker: this is a NEXT_PUBLIC_ variable, which Next.js inlines into
# the client JS bundle at BUILD time, not read at container start. Setting
# it here only affects `npm run dev`/`npm run build` run directly on your
# machine. For the Docker image, pass it as a build arg instead - see
# frontend/Dockerfile and the `build.args` block in docker-compose.yml.
NEXT_PUBLIC_API_URL=http://localhost:8000

# White-labelling: set to false to hide the Testrig company logo from the brand
# lockup (headers, sign-in / registration cards, landing nav and footer). The
# Sentinel mark and product name stay. Unset = logo shown. Build-time, same
# Docker build-arg caveat as above.
NEXT_PUBLIC_SHOW_TESTRIG_LOGO=true
