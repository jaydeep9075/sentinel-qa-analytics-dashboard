# Optional reverse proxy for the backend - see the `caddy` service in
# docker-compose.yml (profile "proxy"). Not used at all unless you run
# `docker compose --profile proxy up -d`.
#
# Point PUBLIC_DOMAIN (in .env) at a real domain whose DNS A record already
# resolves to this host's public IP, and Caddy requests + renews a real
# Let's Encrypt certificate for it automatically - no certbot, no manual
# renewal cron. Leave PUBLIC_DOMAIN unset and it falls back to "localhost",
# which gets Caddy's own locally-trusted cert instead (fine for testing;
# browsers warn on it from another machine since it isn't a public CA).
{$PUBLIC_DOMAIN:localhost} {
	encode gzip

	# Live test-run streaming (SSE) must reach the browser as it's written,
	# not batched - flush_interval -1 flushes on every write instead of
	# buffering. Same requirement documented for nginx in
	# terraform/user_data.sh; this is Caddy's equivalent.
	handle /live/* {
		reverse_proxy backend:8000 {
			flush_interval -1
		}
	}

	# Everything else the backend owns (see services/main.py for the current
	# route list - keep this in sync if a new top-level prefix is added).
	handle /health* /docs* /auth* /ingest* /chat* /chart* /data* /dashboard* /debug* /ingestions* /suggestions* /feedback* /projects* /roles* /test* /usage* /voice* {
		reverse_proxy backend:8000
	}

	# Uncomment this (and add `frontend` to the caddy service's
	# `depends_on` in docker-compose.yml) only if you're self-hosting the
	# frontend on this same box instead of on Vercel - otherwise leave it
	# out and point your DNS/CORS_ALLOWED_ORIGINS at Vercel's domain instead.
	# handle {
	# 	reverse_proxy frontend:3000
	# }
}
