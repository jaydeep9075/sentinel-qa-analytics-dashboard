# Copy to .env (local) or wire into your container platform's secret/env
# injection (docker-compose env_file, k8s Secret, etc). Never commit the
# real .env - see .gitignore. Backed by services/config.py; every default
# shown below is what config.py falls back to if the var is unset.

# --- LLM ---
LLM_PROVIDER=gemini
# Universal key; falls back to OPENAI_API_KEY / GEMINI_API_KEY / ANTHROPIC_API_KEY
# if unset. Required unless LLM_PROVIDER=ollama.
LLM_API_KEY=
LLM_MODEL=models/gemini-2.5-flash
# Only used when LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
# Leave empty for direct provider APIs (Gemini/OpenAI/Anthropic)
LLM_API_BASE=
OPENAI_API_BASE=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Security (required - app refuses to start without these) ---
# Must be >=32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
BCRYPT_ROUNDS=12

# --- CORS ---
# Comma-separated list of origins allowed to call this API. In
# docker-compose local dev this is the frontend's published port.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Auth storage ---
AUTH_BACKEND=db
# Only used if AUTH_BACKEND=db and you want to override the default SQLite
# path (BASE_DIR/users.db) - leave unset unless you know you need this.
AUTH_USER_STORE_URL=
AUTH_AUTO_SEED_USERS=false
AUTH_SEED_FILE=auth_seed_users.json

# --- Workspace ---
DEFAULT_WORKSPACE_ID=default

# --- Live test execution (Playwright reporter -> this backend) ---
# Shared secret the @sentinel/playwright reporter sends as x-api-key.
# Leave empty for local/dev (endpoints are unauthenticated with a startup
# warning); set a real value before exposing this backend beyond localhost.
LIVE_INGEST_API_KEY=
# Only needed once you run more than one backend instance behind a load
# balancer (multi-instance live-execution). Leave unset for a single
# instance - see services/live_exec/bus.py and screencast.py.
REDIS_URL=

# --- RBA context roots ---
PROJECTS_ROOT=projects
ROLES_ROOT=roles

# --- Ingestion guards ---
INGEST_MAX_FILE_SIZE_BYTES=209715200
INGEST_MAX_ROWS=500000
INGEST_TIMEOUT_SECONDS=600
INGESTION_POOL_SIZE=3

# --- Cross-build query limits ---
MAX_TREND_BUILDS=12
MAX_CROSS_BUILD_QUERY_BUILDS=5

# --- Server concurrency (see services/Dockerfile for why this defaults to 1) ---
WEB_CONCURRENCY=1
