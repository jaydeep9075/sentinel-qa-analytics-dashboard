# Copy to .env, fill in section A, and you're done:
#
#     cp .env.example .env
#
# There is ONE .env, at the repo root, and it configures both services.
# frontend/.env.local is NOT part of the Docker setup - it exists only for
# running `npm run dev` directly on your machine (see the note in §D).
#
# Everything outside section A already has a working default, either here, in
# docker-compose.yml, or in services/config.py. Uncomment a line only when you
# actually want to change it.


# =============================================================================
# A. NOTHING IS ACTUALLY REQUIRED - you can leave this whole section blank
# =============================================================================
#
# `docker compose up -d` on an empty .env produces a deployment you can sign
# into: the JWT key self-generates, and the first admin defaults to
# admin/admin with a forced password change on first login (the well-known
# default is a one-time door, not a standing credential - see
# services/auth.py's _bootstrap_admin_if_empty()). Fill these in for a real
# deployment; skip them to try it out.

# 1. JWT signing key. At least 32 characters. Leave blank and one is generated
#    into state/secret_key on first start (back that file up with state/ - if
#    it's ever lost, a new key is generated and everyone is signed out, but
#    nothing else breaks). Set it yourself only if you'd rather manage it as
#    a secret than a file:
#      python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# 2. Your LLM credential. Not required to start the backend any more - leave
#    it blank and finish setup later, as an admin, in Admin -> Settings
#    (provider/model/key are editable at runtime with a "Test connection"
#    button). Required here only if you want it pinned by .env rather than
#    editable from the UI - and only relevant at all unless LLM_PROVIDER is
#    ollama/bedrock/vertex_ai, or LLM_API_BASE points at a gateway that holds
#    the key.
LLM_API_KEY=

# 3. The first admin account, created ONLY when the user database is empty.
#    Leave both blank and you get admin/admin (forced to change password on
#    first login). Set your own here if you'd rather choose the first
#    admin's identity yourself - you'll still get a forced password change
#    unless you also set BOOTSTRAP_ADMIN_FORCE_PASSWORD_CHANGE=false below.
#    Ignored once any user exists, so changing this later does nothing - use
#    the admin console's Users tab to change a password instead.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
#BOOTSTRAP_ADMIN_FORCE_PASSWORD_CHANGE=true
#MIN_PASSWORD_LENGTH=8


# =============================================================================
# B. LLM - provider, model and key all come from here
# =============================================================================
#
# Switching vendors is an edit to these lines plus a restart. No rebuild and
# no code change: they are read at process start.
#
# The key is looked up PER PROVIDER. The active provider's own variable wins,
# and LLM_API_KEY is the fallback - so you can keep every vendor's key in this
# file at once and switch by changing LLM_PROVIDER alone.
#
#   provider    key variable          example LLM_MODEL
#   ---------   -------------------   ---------------------------------
#   gemini      GEMINI_API_KEY        gemini/gemini-2.5-flash
#   anthropic   ANTHROPIC_API_KEY     anthropic/claude-opus-5
#   openai      OPENAI_API_KEY        openai/gpt-4o-mini
#   groq        GROQ_API_KEY          groq/llama-3.3-70b-versatile
#   mistral     MISTRAL_API_KEY       mistral/mistral-large-latest
#   ollama      (none needed)         ollama/llama3
#
# Any other provider litellm supports also works - its key is read from
# <PROVIDER>_API_KEY (or LLM_API_KEY), and you must name LLM_MODEL explicitly
# because there is no built-in default to fall back on.
#
# Startup refuses a provider/model mismatch (e.g. LLM_PROVIDER=anthropic left
# with LLM_MODEL=gemini/...) rather than letting it surface later as a
# confusing 401 from the wrong vendor.

LLM_PROVIDER=gemini
LLM_MODEL=gemini/gemini-2.5-flash

# Optional per-vendor keys. Fill in the ones you have; LLM_PROVIDER decides
# which one is actually used.
#GEMINI_API_KEY=
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=

# Only for proxies / self-hosted gateways (LiteLLM proxy, vLLM, LocalAI, an
# enterprise egress proxy). Setting this also satisfies the API-key check,
# since gateways normally hold the real credential themselves.
#LLM_API_BASE=
# Only when LLM_PROVIDER=ollama. NOTE: `localhost` inside a container means the
# CONTAINER, which has no Ollama. To reach Ollama running on your own machine:
#OLLAMA_URL=http://host.docker.internal:11434


# =============================================================================
# C. Where data lives - HOST paths (the part you change to relocate storage)
# =============================================================================
#
# The container-side paths are fixed (/app/data, /app/users.db, ...). These
# four variables control what gets mounted there from the host, so the same
# image runs against a local folder, a second disk, or a cloud volume with no
# rebuild. Absolute paths are fine.
#
# Windows: use forward slashes - C:/qa-storage/data
# Linux/cloud: /mnt/qa-storage/data
#
# Relative paths are resolved against this file's directory.

#DATA_DIR=./data                     # every ingestion + live run + LanceDB/DuckDB
#STATE_DIR=./state                   # users.db (accounts) + config2.json
#INGEST_SOURCE_DIR=./ingest-source   # drop-box for raw data to import

# All three are DIRECTORIES, and Docker creates them if they don't exist, so
# there is nothing to prepare before the first `docker compose up -d`.
# Back up DATA_DIR and STATE_DIR — between them they hold your builds and
# your accounts.


# =============================================================================
# D. Ports and the browser-facing backend URL
# =============================================================================

#BACKEND_PORT=8000
#FRONTEND_PORT=3000

# The backend URL the BROWSER calls. Next.js inlines every NEXT_PUBLIC_* into
# the client JS bundle at BUILD time, so changing this needs
# `docker compose build frontend`, not just a restart. It must be reachable
# from your browser - `http://backend:8000` will NOT work here.
#NEXT_PUBLIC_API_URL=http://localhost:8000

# Must contain the frontend's origin or every browser call fails CORS.
# Comma-separated for more than one.
CORS_ALLOWED_ORIGINS=http://localhost:3000


# =============================================================================
# E. Ingestion triggers - three ways data gets in
# =============================================================================
#
#   1. The dashboard's "Add Build" box (a path inside the container).
#   2. The drop-box watcher below - a file appears, a build appears.
#   3. POST /ingest/upload - push over HTTP, for CI that can't mount the disk.
#
# All three end up in the same ingester and produce indistinguishable builds.

# --- The watcher ---
# Off by default. When on, the backend polls INGEST_SOURCE_DIR and ingests
# anything new once its size has stopped changing. Files are remembered by
# (name, size, mtime), so restarts don't re-import and replacing a file does.
# Leave it off if people also use that folder as scratch space.

#AUTO_INGEST_ENABLED=true
#AUTO_INGEST_INTERVAL_SECONDS=30   # how often to rescan
#AUTO_INGEST_STABLE_SECONDS=20     # how long size must hold steady before ingesting

# Which workspace a dropped file lands in. The PATH is the routing:
#   <drop-box>/report.zip            -> AUTO_INGEST_DEFAULT_WORKSPACE
#   <drop-box>/platform/report.zip   -> workspace "platform"
# A subdirectory only routes if a workspace of that name exists (create the
# team first); otherwise it stays a source, since an unzipped Allure results
# directory is also a directory.
#AUTO_INGEST_DEFAULT_WORKSPACE=default

# --- HTTP upload ---
# For CI runners that can't mount the data volume. Comma-separated
# key:workspace pairs; the KEY decides the workspace, so a leaked pipeline
# token can only write into the team it was issued for.
#   curl -X POST http://host:8000/ingest/upload -H "x-api-key: ci-abc123" -F "file=@allure-results.zip"
#INGEST_API_KEYS=ci-abc123:platform,ci-def456:mobile
#INGEST_UPLOAD_MAX_BYTES=524288000   # 500MB


# =============================================================================
# F. Accounts, registration and visibility
# =============================================================================

AUTH_BACKEND=db
# Container-side path of the SQLite file. Leave this alone - to point at a
# different file on disk, change USERS_DB_FILE in §C instead; the mount target
# inside the container stays the same.
#AUTH_USER_STORE_URL=sqlite:///./users.db
AUTH_AUTO_SEED_USERS=false
#AUTH_SEED_FILE=./auth_seed_users.json
#BCRYPT_ROUNDS=12

# --- Registration ---
# Self-service signup at /register. New accounts are created PENDING: they
# cannot log in, and have no workspace, until an admin approves them on the
# dashboard's Users page. Signing up therefore grants no access to any data,
# which is what makes it safe to leave on.
#AUTH_ALLOW_SELF_REGISTRATION=true

# Skip the approval queue: registrations become active immediately in
# AUTH_DEFAULT_WORKSPACE with AUTH_DEFAULT_ROLE. Only sane on a trusted
# network - it means anyone who can reach the login page can read that
# workspace's builds.
#AUTH_AUTO_APPROVE_REGISTRATION=false

#AUTH_DEFAULT_ROLE=viewer
#AUTH_DEFAULT_WORKSPACE=default

# --- Visibility ---
# A build belongs to the workspace it was ingested into. Non-admins see only
# their own workspace's builds; admins see all of them.
#DEFAULT_WORKSPACE_ID=default

# Which workspace builds ingested BEFORE ownership tracking existed count as.
# Defaults to the default workspace so an existing install doesn't suddenly
# hide its own history. Set to an unused label (e.g. "archive") to make legacy
# builds admin-only.
#LEGACY_BUILDS_WORKSPACE=default


# =============================================================================
# G. Advanced - defaults are fine for a single-instance deployment
# =============================================================================

#PROJECTS_ROOT=./projects
#ROLES_ROOT=./roles

# Shared secret the @sentinel/playwright reporter sends as x-api-key. Empty
# means the live-ingest endpoints are unauthenticated - set it before exposing
# the backend beyond localhost.
#LIVE_INGEST_API_KEY=

# Ingestion guards
#INGEST_MAX_FILE_SIZE_BYTES=209715200   # 200MB
#INGEST_MAX_ROWS=500000
#INGEST_TIMEOUT_SECONDS=600
#INGESTION_POOL_SIZE=3

# Cross-build query limits
#MAX_TREND_BUILDS=12
#MAX_CROSS_BUILD_QUERY_BUILDS=5

# uvicorn worker processes. Read §5 of DOCKER.md before raising this -
# services/state.py holds the selected ingestion as mutable global state.
#WEB_CONCURRENCY=1

# Only needed for more than one backend replica behind a load balancer
# (`docker compose --profile multi-instance up`).
#REDIS_URL=redis://redis:6379
#REDIS_PORT=6379
