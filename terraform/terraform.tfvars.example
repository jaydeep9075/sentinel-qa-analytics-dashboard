# Copy this file to terraform.tfvars and adjust as needed:
#   cp terraform.tfvars.example terraform.tfvars

aws_region           = "us-east-1"
instance_type        = "t3.large"
root_volume_size_gb  = 50
ssh_public_key_path  = "~/.ssh/id_rsa.pub"

# IMPORTANT: restrict this to your own IP once you've confirmed access works.
# Find your IP: curl -s https://checkip.amazonaws.com
allowed_ssh_cidr = "0.0.0.0/0"

# Optional - leave blank to access Sentinel by IP over plain HTTP.
domain_name = ""
