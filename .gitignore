# Node
node_modules/
npm-debug.log

# Optional—build folders
dist/
build/

# IDE-specific files
.vscode/
.idea/
.env
.env.local

*.pyc
__pycache__/
.pytest_cache/
.ruff_cache/
venv/
.venv/

# Secrets / local credentials — never commit real values, use the .example templates
config.json
auth_seed_users.json

# Mutable runtime state, bind-mounted into the containers: users.db holds
# password hashes, config2.json is edited from the dashboard. Both are
# created automatically on first start.
state/
users.db
users.db-journal

# Runtime-generated ingestion output and token usage data — not source, regenerated per environment
data/
vm-data
vm-data.zip

# Raw data dropped here for the `docker compose run --rm ingest` workflow —
# see docker-compose.yml's `ingest` service and config2.docker.json.example
ingest-source/*
!ingest-source/.gitkeep

# Real client project context (created via POST /admin/projects, or by hand
# for local dev) — was previously committed by mistake (FSA/Lendingwise/
# clippd real context.md + LanceDB embeddings), which is why a fresh clone
# or a pulled backend image used to ship with real project data baked in.
# See docs/08-split-hosting-and-production-readiness.md §2.
projects/*
!projects/.gitkeep

# Client-specific domain notes kept for local LLM context only — never commit.
Knowledge/

# Generated by a since-removed script; not read by any frontend code
# (superseded by GET /ingestions) and it shipped real client test names.
public/builds.json
frontend/public/builds.json

# Live-run client package build output
packages/*/node_modules/
packages/*/dist/
packages/dist-pack/
